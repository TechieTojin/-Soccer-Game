# Inherited ignore rules from the "Soccer on Your Tabletop" pipeline.
# These keep generated pipeline artefacts (masks, point clouds, meshes,
# model weights, intermediate data) out of the repository.
*.pyc
.history.*
.idea/
*.npy
*.txt
*.par
*.json
*.png
*.jpg
*.bz2
*.ply
*.so
*.swp
*.npz
*.m~
*.wav
*.dylib
.DS_Store
*.html
*.exr
*.pth
*.pdf
*.ipynb

# --- Project files that must be committable -------------------------------
# The broad patterns above (*.txt, *.png, *.json, ...) would otherwise
# silently swallow requirements files, tests, docs and screenshots.
# (Audit finding B23)
!requirements.txt
!requirements-*.txt
!tests/
!tests/**
!docs/
!docs/**
!.github/
!.github/**

# Python tooling artefacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
